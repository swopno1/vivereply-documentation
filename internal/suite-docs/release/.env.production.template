# Production environment template — grouped by how badly a missing value
# breaks things. Copy to .env on the VPS and fill in every REQUIRED and
# RECOMMENDED value for every module this deployment actually enables (per
# brand.config.ts). Run `pnpm check:env` after filling this in — it checks
# the same things this file lists. See docs/DEPLOYMENT.md for the full
# deploy sequence and docs/PAYMENTS-<NAME>.md for each gateway's specifics.

# =======================================================================
# REQUIRED — the app refuses to boot/build without these, in production
# =======================================================================
NODE_ENV="production"
DATABASE_URL="postgresql://resort:REPLACE_WITH_LONG_RANDOM_PASSWORD@localhost:5432/resort_prod?schema=public"
# Direct (non-pooled) connection for the Prisma CLI: `migrate deploy` needs a
# session-level connection and HANGS on a transaction pooler. Same database as
# DATABASE_URL on a VPS; the direct string (port 5432) on hosted Postgres.
DIRECT_URL="postgresql://resort:REPLACE_WITH_LONG_RANDOM_PASSWORD@localhost:5432/resort_prod?schema=public"
# openssl rand -base64 32 — throws at boot if unset in production.
BETTER_AUTH_SECRET=""
# The deployment's real public URL — throws at boot if unset in production.
BETTER_AUTH_URL="https://yourresort.com"
# Canonical public URL; used to derive payment callback URLs when not set
# individually (e.g. SSL_CALLBACK_*).
NEXT_PUBLIC_APP_URL="https://yourresort.com"
# Required by every /api/cron/* route — see docs/DEPLOYMENT.md §7.
CRON_SECRET=""
# The first OWNER account. Refuses to run in production without all three
# explicitly set (prisma/seed-admin.ts) — no demo default is used.
SEED_ADMIN_EMAIL="owner@yourdomain.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Resort Owner"

# =======================================================================
# RECOMMENDED — a fallback exists, but every real deployment needs these
# =======================================================================
# Without a real key, every email in production FAILS rather than sending
# (bookings, invitations, password resets). See docs/EMAIL.md.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Without both keys, the /blog/submit guest form stays closed in production.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Needed for the area map, destination maps and /api/cron/fetch-google-reviews.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACE_ID=""
GOOGLE_PLACE_ID=""
# 32 bytes as hex (openssl rand -hex 32): encrypts gateway credentials
# entered in Admin > Settings > Payments. Without it, dashboard credential
# entry is unavailable (env still works).
SETTINGS_ENCRYPTION_KEY=""

# =======================================================================
# PAYMENT GATEWAYS — each block only required if that gateway is enabled
# in brand.config.ts. Run `pnpm check:env` to confirm; leaving any one
# variable unset disables that whole gateway for guests, regardless of the
# config flag.
# =======================================================================

# --- bKash ---
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_TOKEN_SECRET=""              # openssl rand -base64 48
BKASH_CALLBACK_URL=""              # https://yourresort.com/api/payments/bkash/callback
BKASH_WEBHOOK_TOPIC_ARN=""         # AWS SNS topic ARN bKash gives you

# --- Nagad ---
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""      # RSA >= 2048, PEM
NAGAD_PG_PUBLIC_KEY=""
NAGAD_CALLBACK_URL=""
NAGAD_TOKEN_SECRET=""              # openssl rand -hex 32
NAGAD_SERVER_IPV4=""               # this server's public IPv4, whitelisted with Nagad

# --- SSLCommerz ---
SSL_STORE_ID=""
SSL_STORE_PASSWORD=""
SSLCOMMERZ_TOKEN_SECRET=""         # openssl rand -hex 32
# Leave SSL_CALLBACK_* unset to derive from NEXT_PUBLIC_APP_URL, or set all four:
# SSL_CALLBACK_SUCCESS / SSL_CALLBACK_FAIL / SSL_CALLBACK_CANCEL / SSL_CALLBACK_IPN

# --- BanglaQR ---
BANGLAQR_MERCHANT_ID=""
BANGLAQR_ACQUIRING_BANK="sslcommerz"
BANGLAQR_API_KEY=""
BANGLAQR_API_SECRET=""
BANGLAQR_TOKEN_SECRET=""           # openssl rand -hex 32 — required even for static-QR mode
BANGLAQR_WEBHOOK_SECRET=""
# Separate PRIVATE bucket for guest receipts — must not be the general R2
# bucket below. See docs/DATA-RETENTION.md.
R2_RECEIPTS_BUCKET_NAME=""
R2_RECEIPTS_ACCESS_KEY_ID=""
R2_RECEIPTS_SECRET_ACCESS_KEY=""

# --- Stripe (international cards) ---
# Enabled in Admin > Settings > Payments (server-side gateway settings).
STRIPE_SECRET_KEY=""               # sk_live_... — live keys stay in env, never in the dashboard
STRIPE_WEBHOOK_SECRET=""           # whsec_... — from the Stripe dashboard webhook endpoint
# Only needed if a future on-site Elements flow is added.
# STRIPE_PUBLISHABLE_KEY=""

# =======================================================================
# OPTIONAL — feature flags; the feature just doesn't appear when unset
# =======================================================================
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_SENTRY_DSN=""
OPENAI_API_KEY=""                  # chatbot falls back to a static response when unset
# General R2 bucket (blog images) — distinct from the receipts bucket above.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""
# PMS integration (GyoRoom today; ZHMS/AIOSell are future adapters, not yet built)
PMS_WEBHOOK_SECRET=""
GYOROOM_API_KEY=""
GYOROOM_PROPERTY_ID=""
# Concierge staff widget + booking API (server-only; empty = disabled).
CONCIERGE_URL=""
CONCIERGE_BRIDGE_KEY=""
CONCIERGE_SHARED_SECRET=""
# Guest SMS/WhatsApp notices (BZ-M2). Unset = log mode (mocked, demo-safe).
# SMS_PROVIDER=sslwireless needs SSLWIRELESS_API_TOKEN + SSLWIRELESS_SID.
# WHATSAPP_PROVIDER=cloud needs WHATSAPP_TOKEN + WHATSAPP_PHONE_ID plus the
# four approved templates (see .env.example).
# SMS_PROVIDER=""
# WHATSAPP_PROVIDER=""
